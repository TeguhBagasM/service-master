generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Beasiswa {
  id           Int           @id @default(autoincrement())
  nama         String        @db.VarChar(255)
  deskripsi    String        @db.Text
  kuota        Int
  tanggalBuka  DateTime      @map("tanggal_buka")
  tanggalTutup DateTime      @map("tanggal_tutup")
  statusAktif  Boolean       @default(true) @map("status_aktif")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  persyaratan  Persyaratan[]

  @@index([statusAktif])
  @@map("beasiswa")
}

model Persyaratan {
  id          Int      @id @default(autoincrement())
  beasiswaId  Int      @map("beasiswa_id")
  namaDokumen String   @db.VarChar(255) @map("nama_dokumen")
  wajib       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  beasiswa    Beasiswa @relation(fields: [beasiswaId], references: [id])

  @@index([beasiswaId])
  @@map("persyaratan")
}
